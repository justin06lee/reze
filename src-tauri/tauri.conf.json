{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reze",
  "version": "0.1.0",
  "identifier": "com.huiyunlee.reze",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "palette",
        "title": "Reze",
        "width": 720,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true,
        "center": true,
        "acceptFirstMouse": true
      },
      {
        "label": "editor",
        "title": "Reze — Macros",
        "width": 1080,
        "height": 760,
        "minWidth": 780,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Prompt macro launcher",
    "longDescription": "A global-hotkey palette that expands short triggers into full prompts, with variables and snippet includes.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
